local function GetAdvancedPlayerStats(plr)
    local lvl, bnt, fruit = "N/A", "N/A", "None"
    if plr:GetAttribute("Level") then lvl = tostring(plr:GetAttribute("Level")) end
    if plr:GetAttribute("Bounty") or plr:GetAttribute("Belly") then 
        bnt = tostring(plr:GetAttribute("Bounty") or plr:GetAttribute("Belly")) 
    end

    local targets = {plr:FindFirstChild("leaderstats"), plr:FindFirstChild("Data"), plr:FindFirstChild("Stats")}
    for _, folder in ipairs(targets) do
        if folder then
            for _, val in ipairs(folder:GetChildren()) do
                local name = string.lower(val.Name)
                if string.find(name, "level") or string.find(name, "lvl") then lvl = tostring(val.Value) end
                if string.find(name, "bounty") or string.find(name, "belly") or string.find(name, "berries") then bnt = tostring(val.Value) end
                if string.find(name, "fruit") then fruit = tostring(val.Value) end
            end
        end
    end

    if fruit == "None" then
        local searchContainers = {}
        if plr.Character then table.insert(searchContainers, plr.Character) end
        if plr:FindFirstChild("Backpack") then table.insert(searchContainers, plr.Backpack) end
        for _, container in ipairs(searchContainers) do
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and (string.find(item.Name, "Fruit") or string.find(item.Name, "DF")) then
                    fruit = string.gsub(item.Name, " Fruit", "")
                    break
                end
            end
        end
    end
    return lvl, bnt, fruit
end

local function UpdatePlayerTracker()
    for _, child in pairs(TrackerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local myChar = LocalPlayer.Character
    local myPos = (myChar and myChar:FindFirstChild("HumanoidRootPart")) and myChar.HumanoidRootPart.Position or Vector3.zero

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local lvl, bnt, fruit = GetAdvancedPlayerStats(plr)
            local distStr = "?"
            local pChar = plr.Character
            
            if pChar and pChar:FindFirstChild("HumanoidRootPart") and myPos ~= Vector3.zero then
                local dist = math.floor((pChar.HumanoidRootPart.Position - myPos).Magnitude)
                distStr = tostring(dist) .. "m"
            end

            local pBtn = Instance.new("TextButton", TrackerScroll)
            pBtn.Size = UDim2.new(1, -2, 0, 24)
            pBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextSize = 8
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Text = string.format(" %s\n Lvl:%s | Bnt:%s | DF:%s | %s", plr.DisplayName or plr.Name, lvl, bnt, fruit, distStr)

            local pCorner = Instance.new("UICorner", pBtn)
            pCorner.CornerRadius = UDim.new(0, 4)

            pBtn.MouseButton1Click:Connect(function()
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    myChar:PivotTo(CFrame.new(plr.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)))
                    sendNotification("Teleport", "TP ke " .. plr.Name, 2)
                end
            end)
        end
    end
end

