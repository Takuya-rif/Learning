local function ScanFruits()
    for _, child in pairs(FruitScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local myChar = LocalPlayer.Character
    local myPos = (myChar and myChar:FindFirstChild("HumanoidRootPart")) and myChar.HumanoidRootPart.Position or Vector3.zero
    local found = false

    for _, obj in ipairs(workspace:GetChildren()) do
        local name = obj.Name
        if string.find(name, "Fruit") or string.find(name, "Cursed") or obj:FindFirstChild("Handle") then
            local pos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position) or (obj:IsA("BasePart") and obj.Position)
            
            if pos then
                found = true
                local dist = myPos ~= Vector3.zero and math.floor((pos - myPos).Magnitude) or 0
                
                -- Highlight / ESP Effect
                if getgenv().FruitESPEnabled and not obj:FindFirstChild("FruitESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "FruitESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 120)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = obj
                end

                local btn = Instance.new("TextButton", FruitScroll)
                btn.Size = UDim2.new(1, -2, 0, 20)
                btn.BackgroundColor3 = Color3.fromRGB(120, 30, 80)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 9
                btn.Text = string.format(" 🍎 %s (%dm)", name, dist)
                btn.TextXAlignment = Enum.TextXAlignment.Left

                local corner = Instance.new("UICorner", btn)
                corner.CornerRadius = UDim.new(0, 4)

                btn.MouseButton1Click:Connect(function()
                    if myChar then
                        myChar:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
                        sendNotification("Fruit TP", "Teleport ke " .. name, 2)
                    end
                end)
            end
        end
    end

    if not found then
        local lbl = Instance.new("TextButton", FruitScroll)
        lbl.Size = UDim2.new(1, -2, 0, 20)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(120, 120, 130)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 9
        lbl.Text = " Tidak ada buah di sekitar"
    end
end

