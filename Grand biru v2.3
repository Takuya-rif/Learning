local ConfigFolder = "AutoFarmConfig"
local ConfigFile = ConfigFolder .. "/Settings.json"
local DefaultSettings = { AntiAdmin = true }

local function LoadConfig()
    if isfolder and not isfolder(ConfigFolder) then pcall(function() makefolder(ConfigFolder) end) end
    if isfile and isfile(ConfigFile) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(ConfigFile)) end)
        if success and result then return result end
    end
    return DefaultSettings
end

local function SaveConfig()
    if writefile then
        local dataToSave = { AntiAdmin = getgenv().AntiAdminEnabled }
        pcall(function()
            if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
            writefile(ConfigFile, HttpService:JSONEncode(dataToSave))
        end)
    end
end

